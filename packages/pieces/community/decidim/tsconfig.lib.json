{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "noPropertyAccessFromIndexSignature": false,
    "outDir": "./dist",
    "declaration": true,
    "types": [
      "node"
    ],
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {}
  },
  "exclude": [
    "vitest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "include": [
    "src/**/*.ts"
  ]
}
