FROM node:24.14.0-bullseye-slim AS base

ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-client \
        python3 \
        g++ \
        build-essential \
        git \
        poppler-utils \
        poppler-data \
        procps \
        locales \
        unzip \
        curl \
        ca-certificates \
        libcap-dev \
        redis-tools && \
    yarn config set python /usr/bin/python3 && \
    sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && \
    locale-gen en_US.UTF-8

RUN export ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then \
      curl -fSL https://github.com/oven-sh/bun/releases/download/bun-v1.3.1/bun-linux-x64-baseline.zip -o bun.zip; \
    elif [ "$ARCH" = "aarch64" ]; then \
      curl -fSL https://github.com/oven-sh/bun/releases/download/bun-v1.3.1/bun-linux-aarch64.zip -o bun.zip; \
    fi

RUN unzip bun.zip \
    && mv bun-*/bun /usr/local/bin/bun \
    && chmod +x /usr/local/bin/bun \
    && rm -rf bun.zip bun-*

RUN bun --version

RUN --mount=type=cache,target=/root/.npm \
    npm install -g --no-fund --no-audit \
    node-gyp \
    ts-node@10.7.0 \
    npm@11.11.0 \
    pm2@6.0.10 \
    typescript@4.9.4 \
    pnpm@10.33.0 \
    esbuild@0.25.0 \
    wait-on@7.2.0

RUN --mount=type=cache,target=/root/.bun/install/cache \
    cd /usr/src && bun install isolated-vm@6.0.2

FROM base AS build

WORKDIR /usr/src/app

COPY .npmrc package.json bun.lock bunfig.toml ./
COPY packages/ ./packages/

RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile

COPY . .

RUN node <<'EOF'
const fs = require('fs')
const pkgPath = 'packages/server/api/package.json'
const pkg = JSON.parse(fs.readFileSync(pkgPath, 'utf8'))
if (pkg.dependencies) {
  delete pkg.dependencies['@activepieces/piece-microsoft-teams-bot']
}
if (pkg.devDependencies) {
  delete pkg.devDependencies['@activepieces/piece-microsoft-teams-bot']
}
fs.writeFileSync(pkgPath, JSON.stringify(pkg, null, 2) + '\n')
const modPath = 'packages/server/api/src/app/trigger/app-event-routing/app-event-routing.module.ts'
let src = fs.readFileSync(modPath, 'utf8')
const replacements = [
  ["import { microsoftTeamsBot } from '@activepieces/piece-microsoft-teams-bot'\n", ''],
  ["    'microsoft-teams-bot': microsoftTeamsBot,\n", ''],
  ["    'microsoft-teams-bot': '@activepieces/piece-microsoft-teams-bot',\n", ''],
]
for (const [from, to] of replacements) {
  if (!src.includes(from)) {
    throw new Error('octree prune: expected string not found: ' + JSON.stringify(from))
  }
  src = src.replace(from, to)
}
fs.writeFileSync(modPath, src)
EOF

RUN npx turbo run build \
  --filter=web \
  --filter=@activepieces/engine \
  --filter=api \
  --filter=worker \
  --filter=@activepieces/piece-decidim \
  --filter=@activepieces/piece-store \
  --filter=@activepieces/piece-webhook \
  --filter=@activepieces/piece-opnform \
  --filter=@activepieces/piece-whatsapp \
  --filter=@activepieces/piece-state-store \
  --filter=@activepieces/piece-matrix \
  --filter=@activepieces/piece-telegram-bot \
  --filter=@activepieces/piece-tables

RUN rm -rf packages/pieces/custom && \
    find packages/pieces/community -mindepth 1 -maxdepth 1 -type d \
      ! -name decidim \
      ! -name opnform \
      ! -name whatsapp \
      ! -name state-store \
      ! -name slack \
      ! -name square \
      ! -name matrix \
      ! -name facebook-leads \
      ! -name intercom \
      ! -name telegram-bot \
      -exec rm -rf {} + && \
    rm -rf node_modules && \
    rm -f bun.lock package-lock.json && \
    bun install

FROM base AS run

WORKDIR /usr/src/app

ENV AP_API_KEY="api-key" \
    AP_CACHE_PATH="./dev/cache" \
    AP_CHATBOT_ENABLED=true \
    AP_CONFIG_PATH="./dev/config" \
    AP_DB_TYPE=POSTGRES \
    AP_DEV_PIECES="decidim,store,webhook,opnform,whatsapp,state-store,matrix,telegram-bot,tables" \
    AP_ENRICH_ERROR_CONTEXT=true \
    AP_ENVIRONMENT="prod" \
    AP_FRONTEND_URL="http://localhost:8080" \
    AP_LOG_LEVEL=warn \
    AP_LOG_PRETTY=false \
    AP_PIECES_SOURCE='FILE' \
    AP_QUEUE_MODE=REDIS \
    AP_TELEMETRY_ENABLED=false \
    AP_TRIGGER_DEFAULT_POLL_INTERVAL=1 \
    AP_WEBHOOK_TIMEOUT_SECONDS=30 \
    AP_PIECES_SYNC_MODE=NONE \
    AP_WEBHOOK_URL="http://localhost:8080" \
    AP_PORT=80 \
    AP_REDIS_URL="redis://redis:6379" \
    AP_STATE_STORE_NAMESPACE="ap:default" \
    AP_POSTGRES_HOST="postgres" \
    AP_POSTGRES_PORT="5432" \
    AP_POSTGRES_DATABASE="activepieces" \
    AP_POSTGRES_USERNAME="postgres" \
    ROOT=/usr/src/app

COPY --from=build /usr/src/app/packages/server/api/src/assets/default.cf /usr/local/etc/isolate
COPY docker-entrypoint.octree.sh docker-entrypoint.sh

RUN mkdir -p \
    /usr/src/app/dist/packages/engine && \
    chmod +x docker-entrypoint.sh

COPY --from=build /usr/src/app/package.json ./
COPY --from=build /usr/src/app/.npmrc ./
COPY --from=build /usr/src/app/bun.lock ./
COPY --from=build /usr/src/app/bunfig.toml ./
COPY --from=build /usr/src/app/LICENSE .
COPY --from=build /usr/src/app/packages ./packages
COPY --from=build /usr/src/app/dist/packages/engine/ ./dist/packages/engine/

RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --production

COPY --from=build /usr/src/app/dist/packages/web ./dist/packages/web/

LABEL service=activepieces-octree
LABEL author="hadrien@octree.ch"

ENTRYPOINT ["./docker-entrypoint.sh"]
EXPOSE 80
